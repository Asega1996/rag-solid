VECTOR_BACKEND=chroma

LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.1:8b

EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Number of documents to retrieve from the vector store before re-ranking
RETRIEVER_K=10
# Number of top documents to keep after re-ranking (set empty to keep all)
RERANK_N=6

# Alternative vector backends:
# VECTOR_BACKEND=pgvector
# PGVECTOR_CONNECTION=postgresql+psycopg2://user:pass@localhost:5432/ragdb

# VECTOR_BACKEND=qdrant
# QDRANT_URL=https://xxxx.cloud.qdrant.io
# QDRANT_API_KEY=xxxx

# Alternative LLM provider:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Alternative embeddings provider:
# EMBEDDINGS_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small